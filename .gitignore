app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Ensure Gradle wrapper in android/ is tracked
!/android/gradlew
!/android/gradlew.bat
!/android/gradle/
!/android/gradle/wrapper/gradle-wrapper.jar
!/android/gradle/wrapper/gradle-wrapper.properties

# Widget Preview related
.widget_preview/
